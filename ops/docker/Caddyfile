{
	# Produktions-Admin-API nicht exponiert; email für ACME wird von install.sh eingetragen.
	email {$ACME_EMAIL:admin@example.invalid}
	default_sni {$PUBLIC_DOMAIN:localhost}
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_DOMAIN:localhost} {
	# Security-Audit B5: "internal" (selbstsigniertes CA-Zertifikat, Browser-Warnungen) nur für
	# IP-Adressen/localhost/--dev; bei einer echten Domain + ACME-E-Mail setzt install.sh hier die
	# E-Mail-Adresse ein, wodurch Caddy automatisch ein vertrauenswürdiges Let's-Encrypt-Zertifikat
	# bezieht (siehe ensure_public_env_defaults in install.sh).
	tls {$TLS_POLICY:internal}
	encode gzip

	# Security-Audit N13: /health war bisher öffentlich über denselben Origin erreichbar (verrät
	# u.a., dass die Installation existiert/läuft, ohne jeden Nutzen für die Öffentlichkeit). Der
	# Docker-Healthcheck ruft /health direkt am App-Container im internen Netz auf (siehe
	# docker-compose.yml), nicht über Caddy -- die Sperre hier betrifft ausschließlich den
	# öffentlichen Zugriff von außen.
	@health path /health
	respond @health 404

	reverse_proxy app:3000

	header {
		Alt-Svc "clear"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
