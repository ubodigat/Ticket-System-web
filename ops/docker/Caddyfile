{
	# Produktions-Admin-API nicht exponiert; email für ACME wird von install.sh eingetragen.
	email {$ACME_EMAIL:admin@example.invalid}
	default_sni {$PUBLIC_DOMAIN:localhost}
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_DOMAIN:localhost} {
	# TLS_MODE=internal also supports LAN-only DNS names (client CA trust required).
	# TLS_MODE=acme sets TLS_POLICY to the validated ACME email. Public validation
	# access is required; DNS-01 needs an additional issuer/provider configuration.
	tls {$TLS_POLICY:internal}
	encode gzip

	# Security-Audit N13: /health war bisher öffentlich über denselben Origin erreichbar (verrät
	# u.a., dass die Installation existiert/läuft, ohne jeden Nutzen für die Öffentlichkeit). Der
	# Docker-Healthcheck ruft /health direkt am App-Container im internen Netz auf (siehe
	# docker-compose.yml), nicht über Caddy -- die Sperre hier betrifft ausschließlich den
	# öffentlichen Zugriff von außen.
	@health path /health
	respond @health 404

	# Source capabilities are usable only on the private app<->Office network.
	@officeSource path /api/v2/office/source/*
	respond @officeSource 404
	reverse_proxy app:3000

	header {
		Alt-Svc "clear"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

# Optionale, von install.sh abgelegte Sites (z.B. die eigene ONLYOFFICE-Subdomain, Security-Audit R-24).
import /etc/caddy/sites/*.caddy
