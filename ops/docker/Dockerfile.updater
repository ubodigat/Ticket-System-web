FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f

# gnupg wird nur fuer die optionale UPDATE_REQUIRE_SIGNED_COMMITS-Haertung gebraucht
# (git verify-commit, Security-Audit N3).
RUN apk add --no-cache git docker-cli docker-cli-compose ca-certificates gnupg

WORKDIR /updater
COPY ops/docker/updater-server.mjs ./updater-server.mjs

ENV PORT=3099
EXPOSE 3099

CMD ["node", "/updater/updater-server.mjs"]
