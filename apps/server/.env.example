# Vorlage für die lokale Entwicklung ohne Docker. Kopieren nach ".env" und anpassen.
# In einer echten Installation erzeugt install.sh diese Werte automatisch -- diese Datei ist
# nur fuer "npm run dev --workspace=apps/server" gedacht.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ticketsystem
DB_USER=ticketapp
DB_PASSWORD=
# DB_SSL_CA_PATH=/pfad/zu/ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Pfad zu einer Datei mit einem base64-kodierten 256-Bit-Schluessel, z.B. erzeugt via:
#   openssl rand -base64 32 > kek.local
KEK_FILE_PATH=./kek.local

# Mindestens 32 Zeichen, z.B. erzeugt via: openssl rand -base64 48
COOKIE_SECRET=

# Erzeugen via: node -e "console.log(require('crypto').randomUUID())"
INSTALLATION_ID=

SCHEMA_VERSION=1
TRUSTED_PROXY_HOPS=0

# Optional: Selbst-Update über Systemeinstellungen > Update (siehe ops/docker/updater-server.mjs).
# In der lokalen Entwicklung normalerweise leer lassen -- die Oberfläche zeigt dann "nicht
# konfiguriert" an, der Rest der Anwendung funktioniert unverändert.
# UPDATE_SERVICE_URL=http://updater:3099
# UPDATE_TOKEN=
