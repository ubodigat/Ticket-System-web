node_modules/
dist/
build/
coverage/
*.log
.env
.env.*
!.env.example
secrets/
ops/secrets/
ops/tls/
apps/server/secrets/
apps/server/kek.local
ops/docker/secrets/
ops/docker/update-keys/
# Von install.sh erzeugte optionale Caddy-Sites (Security-Audit R-24).
ops/docker/caddy-sites/*.caddy
ops/backups/
# Wiederherstellungs-Kit (enthaelt KEK und privaten Sicherungsschluessel) -- nie versionieren
